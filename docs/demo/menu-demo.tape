Require zsh

Output docs/assets/menu-demo.gif

Set Shell zsh
Set Width 1000
Set Height 560
Set FontSize 18
Set TypingSpeed 45ms
Set Theme "Catppuccin Mocha"
Set LoopOffset 8%

Hide
Type "source docs/demo/setup.zsh"
Enter
Sleep 1s
Show

Ctrl+L
Sleep 500ms
Type "cd "
Tab
Sleep 1500ms
Type "do"
Sleep 1s
Enter
Sleep 600ms
Enter
Sleep 800ms

Type "cd proj"
Enter
Sleep 700ms
Type "cd da"
Enter
Sleep 700ms
Type "cd ../design-system"
Enter
Sleep 900ms

Type "cd- "
Tab
Sleep 1200ms
Down 3
Sleep 700ms
Enter
Sleep 600ms
Enter
Sleep 900ms

Type "cd+ "
Tab
Sleep 1200ms
Down 3
Sleep 700ms
Enter
Sleep 600ms
Enter
Sleep 2s
